{
  "enabled": {
    "description": "启用边界与情感反馈",
    "hint": "关闭后插件不再检测越界、扣分或道歉恢复",
    "type": "bool",
    "default": true
  },
  "deduct_light": {
    "description": "轻度越界扣分",
    "hint": "命中 1 个越界词时扣除的好感度（负值）",
    "type": "int",
    "default": -2
  },
  "deduct_mid": {
    "description": "中度越界扣分",
    "hint": "命中 2 个越界词时扣除的好感度（负值）",
    "type": "int",
    "default": -5
  },
  "deduct_severe": {
    "description": "严重越界扣分",
    "hint": "命中 3 个以上越界词时扣除的好感度（负值）；底线事件按此值的双倍扣",
    "type": "int",
    "default": -8
  },
  "recover_seconds_per_point": {
    "description": "每恢复 1 点好感所需秒数",
    "hint": "扣得越多恢复越慢。默认 1800 秒（30 分钟）恢复 1 点",
    "type": "int",
    "slider": {
      "min": 60,
      "max": 7200,
      "step": 60
    },
    "default": 1800
  },
  "recover_ratio_light": {
    "description": "轻度越界可恢复比例",
    "hint": "0~1，轻度越界最多恢复扣除值的该比例",
    "type": "float",
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    "default": 0.5
  },
  "recover_ratio_mid": {
    "description": "中度越界可恢复比例",
    "type": "float",
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    "default": 0.33
  },
  "recover_ratio_severe": {
    "description": "严重越界可恢复比例",
    "type": "float",
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    "default": 0.25
  },
  "stage_avoid_deduct": {
    "description": "回避阶段阈值（累计扣分）",
    "hint": "累计扣分达到此值进入回避阶段：回复变短、话题转移",
    "type": "int",
    "default": -6
  },
  "stage_forbid_deduct": {
    "description": "明令禁止阶段阈值（累计扣分）",
    "hint": "累计扣分达到此值进入明令禁止阶段：明确说不要这样",
    "type": "int",
    "default": -12
  },
  "stage_reflect_deduct": {
    "description": "反思/冷落阶段阈值（累计扣分）",
    "hint": "累计扣分达到此值进入反思阶段：暂时拒绝深入互动",
    "type": "int",
    "default": -20
  },
  "apology_restore_ratio": {
    "description": "道歉恢复比例",
    "hint": "道歉时恢复的可恢复上限的该比例（再乘严重程度比例）",
    "type": "float",
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    "default": 0.6
  },
  "apology_speedup_multiplier": {
    "description": "道歉后恢复加速倍数",
    "hint": "道歉后剩余好感按此倍数加速恢复",
    "type": "float",
    "slider": {
      "min": 1,
      "max": 10,
      "step": 0.5
    },
    "default": 3.0
  },
  "apology_duplicate_limit": {
    "description": "同类道歉次数上限",
    "hint": "同一类越界道歉超过此次数后不再接受道歉（信任透支）",
    "type": "int",
    "slider": {
      "min": 1,
      "max": 10,
      "step": 1
    },
    "default": 3
  },
  "judge_llm_api_key": {
    "description": "越界/道歉判断 LLM API Key",
    "hint": "用于 LLM 判断消息类型与真诚道歉；留空则跳过 LLM 走关键词兜底",
    "type": "string",
    "default": ""
  },
  "judge_llm_model": {
    "description": "越界/道歉判断 LLM 模型",
